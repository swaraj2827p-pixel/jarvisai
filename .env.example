# Server
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
BODY_LIMIT_BYTES=262144

# LLM provider: mock | openai | anthropic
LLM_PROVIDER=mock
LLM_TIMEOUT_MS=30000

# OpenAI
# OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic
# ANTHROPIC_API_KEY=...
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Optional bearer token required on every /v1 route
# JARVIS_API_KEY=change-me

# Rate limiting (fixed window per client IP)
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Agent loop and session memory
MAX_TOOL_ITERATIONS=6
SESSION_TTL_MS=3600000
MAX_SESSION_MESSAGES=40

# Long-term memory file (JSON key/value store)
MEMORY_FILE=data/jarvis-memory.json
